        "lint:admin": "pnpm build:json:admin && redocly lint dist/admin.v1.json --format stylish",
        "lint:platform": "redocly lint reference/openapi/platform.v1.yaml --format stylish",
        "lint": "pnpm lint:storefront && pnpm lint:admin && pnpm lint:platform",
        "stats:storefront": "pnpm build:json:storefront && redocly stats dist/storefront.v1.json",
        "stats:admin": "pnpm build:json:admin && redocly stats dist/admin.v1.json",
        "stats:platform": "redocly stats reference/openapi/platform.v1.yaml",
        "preview": "pnpm build && http-server dist -p 5055 -c-1",
