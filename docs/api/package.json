        "build:json:admin-phase14": "redocly bundle reference/openapi/admin.phase14.v1.yaml -o dist/admin.phase14.v1.json --ext json",
        "build:json:admin-phase17": "redocly bundle reference/openapi/admin.phase17.v1.yaml -o dist/admin.phase17.v1.json --ext json",
        "build:json:admin-phase18": "redocly bundle reference/openapi/admin.phase18.v1.yaml -o dist/admin.phase18.v1.json --ext json",
        "build:json:admin-customer-intelligence": "redocly bundle reference/openapi/admin.customer-intelligence.v1.yaml -o dist/admin.customer-intelligence.v1.json --ext json",
        "build:json:admin-agentic-commerce": "redocly bundle reference/openapi/admin.agentic-commerce.v1.yaml -o dist/admin.agentic-commerce.v1.json --ext json",
